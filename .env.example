# Chép tệp này thành .env rồi điền. KHÔNG commit .env lên GitHub.

# Tên miền đầy đủ — dùng để dựng link copy trong CRM
SITE_URL=https://vulinh.site

# Chuỗi ngẫu nhiên dùng ký cookie đăng nhập.
# Tạo bằng:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tài khoản quản trị.
# Tạo chuỗi băm bằng:  npm run hash-password -- 'matkhaucuaban'
# Chuỗi sinh ra không chứa ký tự $ — cố ý, vì shell nuốt mất $ khi lưu biến môi trường.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# MySQL — lấy từ cPanel > MySQL Databases (tên có sẵn tiền tố tài khoản cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
